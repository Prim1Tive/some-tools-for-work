  /**
   * Sets required/optional validators for street and TaDoar fields based on street selection.
   * - If street has a REAL street value (not empty, not '0', not '-1', not '-3'), TaDoar is optional
   * - If street is '-3' (no street), street validation passes BUT TaDoar becomes REQUIRED
   * - If TaDoar has a value, street can be optional
   */
  isRequired() {
    const reqSelectedStreetsItems = this.fillingPolicyPageForm.get("selectedStreetsItems");
    const reqTaDoar = this.fillingPolicyPageForm.get("taDoar");
    const SelectedStreetsItemsValue = reqSelectedStreetsItems?.value;
    const TaDoarValue = reqTaDoar?.value;
    const hasRealStreet = SelectedStreetsItemsValue && SelectedStreetsItemsValue !== "" && SelectedStreetsItemsValue !== "0" && SelectedStreetsItemsValue !== "-1" && SelectedStreetsItemsValue !== "-3";
    const isNoStreet = SelectedStreetsItemsValue === "-3";
    const hasTaDoar = TaDoarValue && Number(TaDoarValue) > 0;
    if (hasRealStreet) {
      this.setRequiredFree("taDoar");
      this.setRequiredFree("selectedStreetsItems");
    } else if (isNoStreet) {
      this.setRequiredFree("selectedStreetsItems");
      reqTaDoar?.setValidators([Validators.required]);
    } else if (hasTaDoar) {
      this.setRequiredFree("selectedStreetsItems");
      reqTaDoar?.setValidators([Validators.required]);
    } else {
      reqSelectedStreetsItems?.setValidators([Validators.required]);
      reqTaDoar?.setValidators([Validators.required]);
    }
    reqSelectedStreetsItems?.updateValueAndValidity();
    reqTaDoar?.updateValueAndValidity();
    if (this.selectedPolicyHolder() == 2) {
      this.setRequiredFree("idNo");
      this.setRequiredFree("enterFNDop");
      this.setRequiredFree("enterLNDop");
      this.setRequiredFree("phoneNumberDop");
      this.setRequiredFree("enterEmailDop");
      this.setRequiredFree("birthDateDop");
      this.setRequiredFree("licenseYearDop");
      this.setRequiredFree("selectedCitiesItemsSecond");
      this.setRequiredFree("selectedStreetsItemsSecond");
      this.setRequiredFree("appartNumberSecond");
      this.setRequiredFree("homeNumberSecond");
      this.setRequiredFree("enterNoSecond");
      this.setRequiredFree("taDoarSecond");
      this.setRequiredFree("postCodeSecond");
      this.setRequiredFree("communicationChannelSecond");
      this.setRequiredFree("gender");
    } else {
      const reqSelectedStreetsItemsSecond = this.fillingPolicyPageForm.get("selectedStreetsItemsSecond");
      const reqTaDoarSecond = this.fillingPolicyPageForm.get("taDoarSecond");
      const SelectedStreetsItemsSecondValue = reqSelectedStreetsItemsSecond?.value;
